# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest
**/__screenshots__/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep committed examples
.env
.env.*
!.env.example

# local session / cookie jars
cookies.txt
cookies*.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
