# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/business-management-dashboard
MONGODB_DB=business-management-dashboard

# Invoice email (Resend) — required only when sending invoices / payment reminders
# Create an API key at https://resend.com and verify a sending domain/address.
RESEND_API_KEY=
EMAIL_FROM=invoices@your-verified-domain.com
EMAIL_FROM_NAME=Ledger

# Vercel Cron — required for scheduled invoice payment reminders (/api/cron/invoice-reminders)
# Set the same value in the Vercel project environment. Requests must send:
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Stripe Checkout (optional) — server-only; never use NEXT_PUBLIC_ for these secrets.
# Create test keys at https://dashboard.stripe.com/test/apikeys
# Webhook endpoint: POST /api/webhooks/stripe
# Local forwarding: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
