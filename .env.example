# Copy to .env.local for local development. Never commit real secrets.
# Never put secrets in NEXT_PUBLIC_* variables.

# --- Required in production ---
# App origin (auth trusted origins + public portal/Stripe return URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Session + public token HMAC signing (required in production)
BETTER_AUTH_SECRET=

# MongoDB (required in production)
MONGODB_URI=mongodb://127.0.0.1:27017/business-management-dashboard
MONGODB_DB=business-management-dashboard

# --- Optional integrations (app runs without these; features degrade gracefully) ---

# Invoice / reminder email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Invoice reminder cron (Vercel Cron Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# Stripe (shared secret for invoice Checkout + SaaS subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SaaS subscription Price IDs (server-only; never NEXT_PUBLIC_*)
# Map to Stripe Products/Prices created in the Stripe Dashboard (test mode first).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# AI Business Assistant + optional insight executive summary (server-only)
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o-mini)
OPENAI_MODEL=

# Note: public invoice / portal link TTL is a server constant (30 days), not an env var.
