# Copy to .env.local for local development. Never commit real secrets.

# App origin (used for auth trusted origins + public portal/Stripe return URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Required in production — session + public token HMAC signing
BETTER_AUTH_SECRET=

# Required in production
MONGODB_URI=mongodb://127.0.0.1:27017/business-management-dashboard
MONGODB_DB=business-management-dashboard

# Invoice / reminder email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Invoice reminder cron (Vercel Cron / Bearer)
CRON_SECRET=

# Optional Stripe Checkout + webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
